{
  "name": "quick-kanban-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:api",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "e2e:down": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml down",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "start": "node dist/server/index.js",
    "test:acceptance": "npm run test:db:up && NODE_OPTIONS=\"--import tsx/esm\" cucumber-js; e=$?; npm run test:db:down; exit $e",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:e2e": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml up -d --wait && playwright test",
    "test:ops": "vitest run --config vitest.ops.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.1",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "11.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.13.1",
    "@types/pg": "8.11.11",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.20.0",
    "prettier": "3.5.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "undici": "7.29.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
