# Copy to .env and set a password. .env is gitignored and must stay that way —
# constitution Principle I admits no exception, including for a local database
# password you consider throwaway.

POSTGRES_PASSWORD=change-me
POSTGRES_USER=kanban
POSTGRES_DB=kanban

# The app reaches the database over the compose network; this host name is the
# compose service name, not localhost.
DATABASE_URL=postgres://kanban:change-me@db:5432/kanban

# Your timezone, as an IANA name. The board treats "today", "overdue" and a
# summary's "yesterday" as LOCAL calendar days; the container is UTC without
# this, so a summary generated in the evening would already have rolled over
# and would omit that evening's work. Defaults to America/Costa_Rica.
TZ=America/Costa_Rica

# Published on the loopback interface only. Changing this to 0.0.0.0 exposes an
# unauthenticated board to your network — see FR-034 and BRD decision D-11.
PORT=3000
